<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:elevation="2dp">
    <CheckBox android:id="@+id/checkDone" android:layout_width="44dp" android:layout_height="48dp" android:buttonTint="@color/primary" android:focusable="false"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/txtTaskName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tên công việc" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/txtDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Mô tả công việc" android:textSize="12sp" android:textColor="@color/text_secondary" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/txtDeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hạn: --/--/----" android:textSize="12sp" android:textColor="@color/primary"/>
    </LinearLayout>
    <TextView android:id="@+id/txtPriority" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip" android:text="Cao" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/red" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="7dp" android:paddingBottom="7dp"/>
</LinearLayout>
